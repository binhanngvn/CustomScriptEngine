<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CustomScriptEngine.IL2CPP</AssemblyName>
    <RootNamespace>CustomScriptEngine.BepInEx6.UnityIL2CPP</RootNamespace>
    <OutputType>Library</OutputType>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <BaseOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\build\IL2CPP\</BaseOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <DeploymentOutputDirectory>$(MSBuildThisFileDirectory)..\..\dist\IL2CPP</DeploymentOutputDirectory>
    <!-- InteropDir points to a reusable build-time reference snapshot, not the game
         currently receiving the plugin. The build script creates it once from a
         reference IL2CPP game and reuses it for later builds. -->
    <InteropDir Condition="'$(InteropDir)' == '' and '$(CSE_IL2CPP_INTEROP_DIR)' != ''">$(CSE_IL2CPP_INTEROP_DIR)</InteropDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScriptEngine.Core\ScriptEngine.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.788" IncludeAssets="compile;build;buildTransitive" PrivateAssets="all" />
    <!-- Reference the saved IL2CPP proxy assemblies, not ordinary Unity Mono DLLs. -->
    <!-- IL2CPP proxy types inherit from Il2Cppmscorlib.Object; it must be a compile reference. -->
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(InteropDir)\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(InteropDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateIL2CPPReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(InteropDir)' == ''" Text="IL2CPP build requires InteropDir. Run Build-Both.bat and create the reusable references/IL2CPP snapshot, or pass -p:InteropDir=&quot;C:\Path\To\BepInEx\interop&quot;." />
    <Error Condition="!Exists('$(InteropDir)\Il2Cppmscorlib.dll')" Text="Missing IL2CPP proxy reference: $(InteropDir)\Il2Cppmscorlib.dll. Use a complete BepInEx\interop folder generated by a compatible IL2CPP game." />
    <Error Condition="!Exists('$(InteropDir)\UnityEngine.CoreModule.dll')" Text="Missing IL2CPP proxy reference: $(InteropDir)\UnityEngine.CoreModule.dll." />
  </Target>

  <Target Name="PrepareIL2CPPDeployment" AfterTargets="Build">
    <ItemGroup>
      <DeploymentFiles Include="$(TargetDir)*.dll" />
      <DeploymentFiles Remove="$(TargetDir)BepInEx*.dll" />
      <DeploymentFiles Remove="$(TargetDir)UnityEngine*.dll" />
      <DeploymentFiles Remove="$(TargetDir)Unity*.dll" />
      <DeploymentFiles Remove="$(TargetDir)Mono*.dll" />
      <DeploymentFiles Remove="$(TargetDir)Il2CppInterop*.dll" />
      <DeploymentFiles Remove="$(TargetDir)Il2Cppmscorlib.dll" />
      <DeploymentFiles Remove="$(TargetDir)Il2CppSystem*.dll" />
    </ItemGroup>
    <RemoveDir Directories="$(DeploymentOutputDirectory)" />
    <MakeDir Directories="$(DeploymentOutputDirectory)" />
    <Copy SourceFiles="@(DeploymentFiles)" DestinationFolder="$(DeploymentOutputDirectory)" SkipUnchangedFiles="true" />
    <WriteLinesToFile File="$(DeploymentOutputDirectory)\INSTALL.txt" Overwrite="true" Lines="CustomScriptEngine IL2CPP: copy the contents of this folder into BepInEx\plugins\CustomScriptEngine on an IL2CPP game with compatible BepInEx 6. See the root README for script API and limitations." />
  </Target>
</Project>
